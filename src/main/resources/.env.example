# ==================== LLM AI 配置 ====================
# 请将你的 API Key 填入下方（支持 OpenAI、DeepSeek 等）
OPENAI_API_KEY=sk-your-actual-api-key-here

# DeepSeek API 示例
# OPENAI_API_KEY=sk-a6d82459c6364835a566c8b855e29568
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-flash

# OpenAI API 示例（默认）
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-3.5-turbo

# ==================== 数据库配置 ====================
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/soulchat
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# ==================== RabbitMQ 配置 ====================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ==================== JWT 配置 ====================
JWT_SECRET=your-256-bit-secret-key-for-jwt-signing-must-be-at-least-32-characters-long
JWT_EXPIRATION=86400000

# ==================== 服务器配置 ====================
SERVER_PORT=8080
